root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{sln,vcxproj,props,inf,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 2

[*.{md,yml,yaml,cff}]
end_of_line = lf
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

